# Django Settings
SECRET_KEY=your-very-strong-secret-key-minimum-32-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=core.settings.prod

# # MySQL Database
# MYSQL_ROOT_PASSWORD=your-strong-root-password
# MYSQL_DATABASE=academy_db
# MYSQL_USER=academy_user
# MYSQL_PASSWORD=academy-password
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# SMS (Kavehnegar)
# KAVEHNEGAR_API_KEY=10100101010100100101
# KAVEHNEGAR_SENDER=1001001001010
# KAVENEGAR_TEMPLATE_NAME=template-name

# Claude Agent (Anthropic)
# Required by POST /agent/chat/ and by the submission reviewer; leaving it blank
# returns 503 on the chat endpoint and disables the model-backed half of the
# reviewer. Note that nothing in this project loads .env into the process
# environment - Docker Compose injects it via env_file. For a local
# `manage.py runserver`, export the variable in your shell instead.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_THROTTLE_RATE=20/hour

# Automated first-pass review of institute submissions. When on, a POST or a
# meaningful edit to the profile/branding endpoints schedules a background check
# and records anything questionable in the matching *_problem field. The
# submission is never blocked and `status` is never changed - an administrator
# still approves or rejects. Set to False to switch the feature off entirely.
# The landline area-code check is deterministic and needs no API key; the name
# and logo/banner checks need ANTHROPIC_API_KEY.
AGENT_MODERATION_ENABLED=True

# Upstream endpoint. AgentRouter's Anthropic-compatible base URL takes no `/v1`
# suffix; use https://api.anthropic.com to talk to Anthropic directly.
AGENT_BASE_URL=https://agentrouter.org

# AgentRouter rejects unrecognised clients with a 401 regardless of the key, so the
# outgoing User-Agent has to be one it allowlists. Set this to an empty value when
# AGENT_BASE_URL points at api.anthropic.com.
AGENT_USER_AGENT=claude-cli/2.0.14 (external, cli)